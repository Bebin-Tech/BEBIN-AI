# API
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173
LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=true
DATABASE_URL=sqlite:///./bebin_ai.db

# Web
VITE_API_BASE_URL=http://127.0.0.1:8000

# Local model artifacts
MODEL_TOKENIZER_PATH=artifacts/tokenizer/tokenizer.json
MODEL_CHECKPOINT_PATH=artifacts/runs/smoke/last.pt
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400

# PostgreSQL for docker-compose
POSTGRES_DB=bebin_ai
POSTGRES_USER=bebin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
